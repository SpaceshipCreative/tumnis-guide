#!/usr/bin/env python3
"""A stand-in `hermes` for the daemon's tests (P1-04, T-P1-04-16; P2-07).

`hermes -p <profile> chat --query-file <f> -s <skill> --format stream-json --source tool`
replays the recording named by HERMES_STUB_RECORDING line by line on stdout. With
HERMES_STUB_SLEEP it first starts a child sharing its process group (both pids go to
HERMES_STUB_PIDFILE), and sleeps that many seconds, so a timeout must kill the group.
HERMES_STUB_STDERR_FILE gets the path the stub's stderr points at (Linux /proc).
`profile show`, `version`, `mcp list` and `status` answer for the health check.
P1-06: every call's argv is appended, tab-joined, to HERMES_STUB_LOG when set. With
HERMES_STUB_PROFILES_DIR, `profile show <n>` succeeds when that directory has <n> and
`profile install <dir> --name <n> --yes` creates it and `profile delete <n> --yes`
removes it; unset, only `acme-site` exists.

P2-07: HERMES_STUB_CWD_FILE gets a JSON note of where the run happened (its working
directory, whether that is a linked git worktree, whether the query file sits in its
`.tumnis/`). With HERMES_STUB_SIGNALS the stub notes each SIGTERM in that file and keeps
running (only SIGKILL ends it). HERMES_STUB_TOUCH names a file the stub writes in its
working directory after replaying the recording.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path


def _note_term(signum: int, frame: object) -> None:
    del frame
    with Path(os.environ["HERMES_STUB_SIGNALS"]).open("a") as f:
        f.write(f"{signal.Signals(signum).name}\n")


def _note_cwd(query: Path) -> None:
    cwd_file = os.environ.get("HERMES_STUB_CWD_FILE")
    if not cwd_file:
        return
    cwd = Path.cwd()
    note = {
        "cwd": str(cwd),
        "git_file": (cwd / ".git").is_file(),
        "query_in_tumnis": query.resolve().parent == (cwd / ".tumnis").resolve(),
    }
    Path(cwd_file).write_text(json.dumps(note))


def chat(args: list[str]) -> int:
    query = Path(args[args.index("--query-file") + 1])
    if not query.is_file():
        print(f"no query file {query}", file=sys.stderr)
        return 2
    _note_cwd(query)
    if os.environ.get("HERMES_STUB_SIGNALS"):
        signal.signal(signal.SIGTERM, _note_term)
    stderr_file = os.environ.get("HERMES_STUB_STDERR_FILE")
    if stderr_file:
        Path(stderr_file).write_text(os.readlink("/proc/self/fd/2"))
    pidfile = os.environ.get("HERMES_STUB_PIDFILE")
    sleep_s = float(os.environ.get("HERMES_STUB_SLEEP", "0"))
    if sleep_s:
        child = subprocess.Popen(["sleep", str(int(sleep_s) + 30)])  # noqa: S603, S607
        if pidfile:
            Path(pidfile).write_text(f"{os.getpid()} {child.pid}\n")
        time.sleep(sleep_s)
    recording = os.environ.get("HERMES_STUB_RECORDING")
    if recording:
        for line in Path(recording).read_text().splitlines():
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
    touch = os.environ.get("HERMES_STUB_TOUCH")
    if touch:
        (Path.cwd() / touch).write_text("changed by the stub\n")
    return 0


def profile(argv: list[str]) -> int:
    profiles_dir = os.environ.get("HERMES_STUB_PROFILES_DIR")
    if argv[1] == "show":
        if profiles_dir is None:
            return 0 if argv[2:3] == ["acme-site"] else 1
        return 0 if (Path(profiles_dir) / argv[2]).is_dir() else 1
    if argv[1] == "delete" and profiles_dir is not None:
        target = Path(profiles_dir) / argv[2]
        if not target.is_dir():
            return 1
        shutil.rmtree(target)
        return 0
    if argv[1] == "install" and profiles_dir is not None and "--name" in argv:
        if not Path(argv[2], "distribution.yaml").is_file():
            print(f"no distribution at {argv[2]}", file=sys.stderr)
            return 1
        name = argv[argv.index("--name") + 1]
        (Path(profiles_dir) / name).mkdir(parents=True)
        return 0
    print(f"stub hermes: unknown command {argv}", file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    log = os.environ.get("HERMES_STUB_LOG")
    if log:
        with Path(log).open("a", encoding="utf-8") as f:
            f.write("\t".join(argv) + "\n")
    if "chat" in argv:
        return chat(argv)
    if argv[:1] == ["version"]:
        print("hermes 0.9.0")
        return 0
    if argv[:1] == ["profile"] and len(argv) >= 3:
        return profile(argv)
    if "mcp" in argv and "list" in argv:
        print("tumnis  http://tumnis.example.org/mcp  enabled")
        return 0
    if "status" in argv:
        return 0
    print(f"stub hermes: unknown command {argv}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
