{
  "$id": "https://tumnis.dev/schemas/entities/v1/artifact.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A pull request, deployment or similar object with a state (GitHub, Coolify).",
  "properties": {
    "checks": {
      "additionalProperties": true,
      "title": "Checks",
      "type": "object"
    },
    "external_id": {
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "provider_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Url"
    },
    "record_type": {
      "const": "artifact",
      "default": "artifact",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "schema_version",
    "external_id",
    "fetched_at",
    "kind"
  ],
  "title": "ArtifactRecord",
  "type": "object"
}
