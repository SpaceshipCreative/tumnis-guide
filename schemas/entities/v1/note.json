{
  "$id": "https://tumnis.dev/schemas/entities/v1/note.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Meeting notes (Granola) with their action items.",
  "properties": {
    "action_items": {
      "items": {
        "type": "string"
      },
      "title": "Action Items",
      "type": "array"
    },
    "attendees": {
      "items": {
        "type": "string"
      },
      "title": "Attendees",
      "type": "array"
    },
    "body_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Text"
    },
    "end_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End At"
    },
    "event_external_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event External Id"
    },
    "external_id": {
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "provider_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Url"
    },
    "record_type": {
      "const": "note",
      "default": "note",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start At"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "schema_version",
    "external_id",
    "fetched_at"
  ],
  "title": "NoteRecord",
  "type": "object"
}
