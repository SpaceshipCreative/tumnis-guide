{
  "$id": "https://tumnis.dev/schemas/events/v1/key.created.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "key_id": {
      "format": "uuid",
      "title": "Key Id",
      "type": "string"
    },
    "prefix": {
      "title": "Prefix",
      "type": "string"
    },
    "project_ids": {
      "anyOf": [
        {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Ids"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "title": "Scopes",
      "type": "array"
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ip"
    }
  },
  "required": [
    "schema_version",
    "key_id",
    "prefix",
    "scopes"
  ],
  "title": "KeyCreatedV1",
  "type": "object"
}
