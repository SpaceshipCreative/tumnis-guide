{
  "$id": "https://tumnis.dev/schemas/events/v1/run.signal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "result",
        "cancel",
        "limit",
        "waiting",
        "resumed",
        "runner_lost",
        "agent_failed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind"
  ],
  "title": "RunSignalV1",
  "type": "object"
}
