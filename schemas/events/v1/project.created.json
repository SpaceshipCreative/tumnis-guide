{
  "$id": "https://tumnis.dev/schemas/events/v1/project.created.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brief_md": {
      "default": "",
      "maxLength": 65536,
      "title": "Brief Md",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "name"
  ],
  "title": "ProjectCreatedV1",
  "type": "object"
}
