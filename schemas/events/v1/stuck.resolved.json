{
  "$id": "https://tumnis.dev/schemas/events/v1/stuck.resolved.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "focus_event_id": {
      "format": "uuid",
      "title": "Focus Event Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "split",
        "took_step"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "step_task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Task Id"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "focus_event_id",
    "task_id",
    "run_id",
    "outcome"
  ],
  "title": "StuckResolvedV1",
  "type": "object"
}
