{
  "$defs": {
    "RunKind": {
      "enum": [
        "enrich",
        "plan",
        "task",
        "proposal",
        "stuck",
        "notify"
      ],
      "title": "RunKind",
      "type": "string"
    }
  },
  "$id": "https://tumnis.dev/schemas/events/v1/run.finished.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    },
    "kind": {
      "$ref": "#/$defs/RunKind"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "runner_lost"
      ],
      "title": "Status",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Task Id"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "kind",
    "status"
  ],
  "title": "RunFinishedV1",
  "type": "object"
}
