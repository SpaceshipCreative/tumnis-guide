{
  "$defs": {
    "RunKind": {
      "enum": [
        "enrich",
        "plan",
        "task",
        "proposal",
        "stuck",
        "notify"
      ],
      "title": "RunKind",
      "type": "string"
    }
  },
  "$id": "https://tumnis.dev/schemas/events/v1/run.started.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "#/$defs/RunKind"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "running",
      "default": "running",
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Task Id"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "project_id",
    "kind"
  ],
  "title": "RunStartedV1",
  "type": "object"
}
