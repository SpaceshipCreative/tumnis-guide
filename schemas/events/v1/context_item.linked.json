{
  "$id": "https://tumnis.dev/schemas/events/v1/context_item.linked.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A task newly linked to outside content through a ContextItem (P2-03: the digest\ncarries the item's full text, read when the digest is read).",
  "properties": {
    "context_item_id": {
      "format": "uuid",
      "title": "Context Item Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "target_type": {
      "title": "Target Type",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_item_id",
    "task_id",
    "project_id",
    "target_type"
  ],
  "title": "ContextItemLinkedV1",
  "type": "object"
}
