{
  "$id": "https://tumnis.dev/schemas/events/v1/human.decided.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "item_id": {
      "format": "uuid",
      "title": "Item Id",
      "type": "string"
    },
    "item_kind": {
      "title": "Item Kind",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "previous": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "item_kind",
    "item_id",
    "target_type",
    "target_id",
    "decision"
  ],
  "title": "HumanDecidedV1",
  "type": "object"
}
