{
  "$id": "https://tumnis.dev/schemas/runner/v2/ack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Protocol 2: one ack for up to 50 messages, in either direction.",
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "message_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Message Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "ack",
      "default": "ack",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "message_ids"
  ],
  "title": "AckBatch",
  "type": "object"
}
