{
  "$id": "https://tumnis.dev/schemas/runner/v1/result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "hermes_session_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hermes Session Id"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "output_json": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Json"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "maxLength": 65536,
      "title": "Text",
      "type": "string"
    },
    "tokens": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens"
    },
    "type": {
      "const": "result",
      "default": "result",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "run_id",
    "status",
    "exit_code",
    "output_json",
    "text",
    "duration_ms"
  ],
  "title": "Result",
  "type": "object"
}
