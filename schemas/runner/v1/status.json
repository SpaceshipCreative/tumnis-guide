{
  "$id": "https://tumnis.dev/schemas/runner/v1/status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Protocol 2: a run's state (`started` carries the profile's VERSION; `gap` declares\nstream lines the daemon's full outbox dropped), or a profile-level report without a\nrun.",
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile"
    },
    "profile_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile Version"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "state": {
      "enum": [
        "started",
        "waiting",
        "cancelling",
        "gap"
      ],
      "title": "State",
      "type": "string"
    },
    "type": {
      "const": "status",
      "default": "status",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "run_id",
    "profile",
    "profile_version",
    "state"
  ],
  "title": "Status",
  "type": "object"
}
