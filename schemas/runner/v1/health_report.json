{
  "$defs": {
    "McpServerInfo": {
      "additionalProperties": false,
      "description": "One MCP server of a profile (P2-10): its name, transport and a redacted target (the\ncommand's name, or the URL's host); never its arguments, env or headers (FR-5.12).",
      "properties": {
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 253,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "transport": {
          "enum": [
            "stdio",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport"
      ],
      "title": "McpServerInfo",
      "type": "object"
    },
    "TokenReach": {
      "additionalProperties": false,
      "description": "What one token reaches, as the daemon probed it on the host (the token itself never\nleaves the host). GitHub: a repo is reachable only with `permissions.push` or `admin`;\nCoolify: an application is reachable when the token may read it.",
      "properties": {
        "errors": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Errors",
          "type": "array"
        },
        "foreign_reachable": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Foreign Reachable",
          "type": "array"
        },
        "own_reachable": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "maxProperties": 50,
          "title": "Own Reachable",
          "type": "object"
        },
        "token_present": {
          "title": "Token Present",
          "type": "boolean"
        }
      },
      "required": [
        "token_present"
      ],
      "title": "TokenReach",
      "type": "object"
    }
  },
  "$id": "https://tumnis.dev/schemas/runner/v1/health_report.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authenticated"
    },
    "coolify": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenReach"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "github": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenReach"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hermes_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hermes Version"
    },
    "mcp_server_details": {
      "default": [],
      "items": {
        "$ref": "#/$defs/McpServerInfo"
      },
      "maxItems": 200,
      "title": "Mcp Server Details",
      "type": "array"
    },
    "mcp_servers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Mcp Servers",
      "type": "array"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "profile": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Profile",
      "type": "string"
    },
    "profile_exists": {
      "title": "Profile Exists",
      "type": "boolean"
    },
    "profile_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Version"
    },
    "reachable": {
      "title": "Reachable",
      "type": "boolean"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "health_report",
      "default": "health_report",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "request_id",
    "profile",
    "profile_exists",
    "reachable",
    "authenticated",
    "hermes_version"
  ],
  "title": "HealthReport",
  "type": "object"
}
