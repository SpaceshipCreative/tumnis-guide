{
  "$id": "https://tumnis.dev/schemas/runner/v1/registered.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "heartbeat_interval_s": {
      "const": 15,
      "default": 15,
      "title": "Heartbeat Interval S",
      "type": "integer"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "protocol_version": {
      "title": "Protocol Version",
      "type": "integer"
    },
    "runner_id": {
      "format": "uuid",
      "title": "Runner Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "registered",
      "default": "registered",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "runner_id",
    "protocol_version"
  ],
  "title": "Registered",
  "type": "object"
}
