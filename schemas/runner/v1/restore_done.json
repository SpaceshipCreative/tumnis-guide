{
  "$id": "https://tumnis.dev/schemas/runner/v1/restore_done.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "P2-18: the answer to `restore`: ok when the restored tree's manifest digest is the\nexpected one.",
  "properties": {
    "archive_id": {
      "maxLength": 128,
      "title": "Archive Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "manifest_digest": {
      "maxLength": 64,
      "title": "Manifest Digest",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "restore_done",
      "default": "restore_done",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "archive_id",
    "manifest_digest",
    "ok"
  ],
  "title": "RestoreDone",
  "type": "object"
}
