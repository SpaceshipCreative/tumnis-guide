{
  "$id": "https://tumnis.dev/schemas/runner/v1/upload_artifact.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Protocol 2: a small text artifact of a run. The fields are deliberately loose: the\nserver checks media type, UTF-8, size and sha256 itself and answers `nack{code}`.",
  "properties": {
    "content": {
      "title": "Content",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "media_type": {
      "maxLength": 255,
      "title": "Media Type",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "type": {
      "const": "upload_artifact",
      "default": "upload_artifact",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "run_id",
    "name",
    "media_type",
    "size",
    "sha256",
    "content"
  ],
  "title": "UploadArtifact",
  "type": "object"
}
