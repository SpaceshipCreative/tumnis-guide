{
  "$id": "https://tumnis.dev/schemas/runner/v1/health_check.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coolify_base_url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coolify Base Url"
    },
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "foreign_apps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Foreign Apps",
      "type": "array"
    },
    "foreign_repos": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Foreign Repos",
      "type": "array"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "own_apps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Own Apps",
      "type": "array"
    },
    "own_repos": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Own Repos",
      "type": "array"
    },
    "profile": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Profile",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "type": {
      "const": "health_check",
      "default": "health_check",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "request_id",
    "profile"
  ],
  "title": "HealthCheck",
  "type": "object"
}
