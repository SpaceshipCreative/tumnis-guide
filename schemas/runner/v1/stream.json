{
  "$id": "https://tumnis.dev/schemas/runner/v1/stream.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Protocol 2: one line of a run's output, numbered per run from 1.",
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "title": "Correlation Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "log",
        "tool_call",
        "file_touched"
      ],
      "title": "Kind",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "text": {
      "maxLength": 8192,
      "title": "Text",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "stream",
      "default": "stream",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "sent_at",
    "run_id",
    "seq",
    "kind",
    "text",
    "ts"
  ],
  "title": "Stream",
  "type": "object"
}
