# Tumnis Guide: the server's .env for an install without Coolify (README, Install).
# Copy it to .env in the repository root; `docker compose`, run from the root, reads it from
# there. Keep .env mode 600 and never commit it (.gitignore lists it).
#
# Secrets are not kept here. The master key, the API key pepper and the /metrics token are
# files in /etc/tumnis/secrets, readable only by the service user (README, Install), and
# per-workspace secrets (OAuth clients, storage keys) are sealed in the database through
# Settings. Only service passwords and hosted provider keys live in this
# file.

# --- Compose ----------------------------------------------------------------------------
# The stack, and the `standalone` profile that adds the HTTPS proxy (Caddy).
COMPOSE_FILE=deploy/compose.yaml
COMPOSE_PROFILES=standalone
# The image tag the stack runs: `local` is the image the README builds from this checkout.
TUMNIS_VERSION=local

# --- Where people reach it --------------------------------------------------------------
# The name you open in the browser: the machine's Tailscale name (for example
# tumnis.tailnet-name.ts.net) for use from the phone, or localhost to try it on this
# machine. The README's install step writes all three from TUMNIS_HOST.
TUMNIS_HOST=localhost
PUBLIC_BASE_URL=https://localhost
# The one address the proxy listens on (port 443): 127.0.0.1, or the machine's Tailscale
# address (`tailscale ip -4`). Never 0.0.0.0: Tumnis is for your private network only.
TUMNIS_BIND_ADDRESS=127.0.0.1

# --- Database passwords -------------------------------------------------------------------
# Filled by the README with `openssl rand -hex 24` (hex: they go into connection URLs).
APP_DB_PASSWORD=
OWNER_DB_PASSWORD=
POSTGRES_PASSWORD=

# --- Backups ------------------------------------------------------------------------------
# WAL archiving and pgBackRest (docs/OPERATIONS.md, Backups). Off until the off-site
# repository (Backblaze B2) and its keys are set up; while off, /health/ready reports
# `backups: degraded`. Then set it to on and run `docker compose up -d`.
TUMNIS_BACKUPS=off

# --- Optional -----------------------------------------------------------------------------
# Error reports to GlitchTip (a DSN) and traces to an OTLP/HTTP collector; unset, both off.
# SENTRY_DSN=https://public-key-placeholder@glitchtip.example.com/1
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
# The deployment's own settings, read by every process; the defaults suit this install.
# DEPLOYMENT_ENV=prod
# TUMNIS_ADAPTERS=real

# --- Hosted provider keys -----------------------------------------------------------------
# Hosted provider API keys belong in this file, never in the database or the repository
# (Scott decision 75). Both providers are optional and off while any of their URL, model
# or key is blank; only the worker receives these variables. Without them, speech uses the
# browser's voice or your own Piper server (Settings > Voice), and embeddings your own
# vLLM server, if any. The Jev (TypeSafe) key is not here: it is TYPESAFE_API_KEY in each
# agent profile's .env (README, Agents). deploy/.env.example lists the same variables for
# a Coolify install.
#
# Hosted speech: an OpenAI-compatible /v1/audio/speech API, used only for workspaces that
# allow hosted speech and never for a local-only project. VOICE is optional.
SPEECH__HOSTED_BASE_URL=
SPEECH__HOSTED_MODEL=
SPEECH__HOSTED_VOICE=
SPEECH__HOSTED_API_KEY=
# Hosted embedder: an OpenAI-compatible /v1/embeddings API. A local embedder, when set,
# stays preferred, and a local-only project's text never goes here. DIMS is the model's
# vector size (blank: 1024, at most 2000).
EMBEDDINGS__HOSTED_BASE_URL=
EMBEDDINGS__HOSTED_MODEL=
EMBEDDINGS__HOSTED_DIMS=
EMBEDDINGS__HOSTED_API_KEY=
