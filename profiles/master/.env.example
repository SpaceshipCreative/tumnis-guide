# The master profile's own .env (never in the repo): copy this file to the installed
# profile as .env and fill in each value there. Hermes fills config.yaml's ${VAR}
# placeholders from it.
# Tumnis's base URL, without /mcp.
TUMNIS_URL=
# The master's own Tumnis key, used by cron jobs (the workspace digest). A run gets its
# task token from the daemon instead.
TUMNIS_TOKEN=
# The TypeSafe API key for the Jev MCP server.
TYPESAFE_API_KEY=
# The Discord gateway (P2-16). The bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
# The person's Discord user id: the only user the bot answers.
DISCORD_ALLOWED_USERS=
# The one channel id, set in both: the only channel the bot listens in, and its home
# channel, where it posts focus messages. In gateway sessions the bot uses TUMNIS_TOKEN
# above, so that key needs the delegate scope (pause_agents and record_human_reply).
DISCORD_ALLOWED_CHANNELS=
DISCORD_HOME_CHANNEL=
