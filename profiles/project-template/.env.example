# The profile's own .env (never in the repo): copy this file to the installed profile as
# .env and fill in each value there. Hermes fills config.yaml's ${VAR} placeholders from it.
# Tumnis's base URL, without /mcp.
TUMNIS_URL=
# The profile's own Tumnis key, used by cron jobs (the project digest). A task run gets
# the run's task token from the daemon instead.
TUMNIS_TOKEN=
# The project's GitHub token (fine-grained, this project's repositories only).
GITHUB_PERSONAL_ACCESS_TOKEN=
# The project's Coolify instance, without /mcp, and its API token.
COOLIFY_BASE_URL=
COOLIFY_TOKEN=
# The TypeSafe API key for the Jev MCP server.
TYPESAFE_API_KEY=
