[importlinter]
root_package = tumnis
include_external_packages = True

[importlinter:contract:modules-api-only]
name = Modules reach each other only through api.py
type = independence
modules =
    tumnis.modules.auth
    tumnis.modules.projects
    tumnis.modules.tasks
    tumnis.modules.planning
    tumnis.modules.agents
    tumnis.modules.focus
    tumnis.modules.decisions
    tumnis.modules.search
    tumnis.modules.knowledge
    tumnis.modules.integrations
    tumnis.modules.calendar
    tumnis.modules.github
    tumnis.modules.coolify
    tumnis.modules.notifications
    tumnis.modules.usage
ignore_imports =
    tumnis.modules.** -> tumnis.modules.*.api
# decisions has a second public interface, the Generation slot (P1-03); who may use it is
# narrowed further by generation-callers below.
    tumnis.modules.** -> tumnis.modules.decisions.generation_api
# The one sanctioned test-only exception (P0-12): every module's connector contract tests
# subclass integrations' ConnectorContract.
    tumnis.modules.*.tests.** -> tumnis.modules.integrations.connector_contract
# P2-13: tasks calls github (linking a pull request); github's integration tests link one
# through tasks' api and hand `artifact.updated` to tasks' subscriber (T-P2-13-07), which
# has no api entry. Module code never imports tasks.
    tumnis.modules.github.tests.** -> tumnis.modules.tasks.events
# Until modules call each other, the api ignore matches nothing; that is not an error.
unmatched_ignore_imports_alerting = none

[importlinter:contract:rules-are-pure]
name = rules.py imports nothing that does I/O
type = forbidden
source_modules =
    tumnis.modules.*.rules
    tumnis.modules.knowledge.sync_rules
forbidden_modules =
    tumnis.core.db
    tumnis.core.tenancy
    tumnis.core.outbox
    tumnis.core.events
    tumnis.core.cache
    tumnis.core.net
    tumnis.core.adapters
    tumnis.core.audit
    tumnis.modules.*.models
    tumnis.modules.*.workflows
    tumnis.modules.*.adapters
    tumnis.modules.*.router
    tumnis.modules.*.mcp
    sqlalchemy
    psycopg
    dbos
    fastapi
    httpx
    aioboto3
    asyncssh
    redis
    structlog

[importlinter:contract:core-below-modules]
name = core never imports a module or a composition root
type = forbidden
source_modules =
    tumnis.core
forbidden_modules =
    tumnis.modules
    tumnis.app
    tumnis.worker
    tumnis.cli
    tumnis.wiring
# Core's own tests drive the app factory, the CLI and the worker's schedules (P0-04: health,
# boot guard, commands; P0-28: backup schedule); core code itself still never imports a
# composition root.
ignore_imports =
    tumnis.core.tests.** -> tumnis.app
    tumnis.core.tests.** -> tumnis.cli
    tumnis.core.tests.** -> tumnis.wiring
    tumnis.core.tests.** -> tumnis.worker
# T-P0-08-12 lives with core's tests (plan) but checks auth's pure is_iana_zone rule.
    tumnis.core.tests.unit.test_iana -> tumnis.modules.auth.rules
unmatched_ignore_imports_alerting = none

[importlinter:contract:module-graph-acyclic]
name = No cycles between modules
type = acyclic_siblings
ancestors =
    tumnis.modules
# calendar and knowledge build on integrations (P0-12); integrations' own tests call their
# upserts to prove records owned elsewhere go there (T-P0-12-11). Module code never does.
ignore_imports =
    tumnis.modules.integrations.tests.** -> tumnis.modules.calendar.api
    tumnis.modules.integrations.tests.** -> tumnis.modules.knowledge.api
# tasks builds on github (P2-13: pull requests on task cards); github's own tests drive
# tasks' api and subscriber to prove the round trip. Module code never does.
    tumnis.modules.github.tests.** -> tumnis.modules.tasks.api
    tumnis.modules.github.tests.** -> tumnis.modules.tasks.events
unmatched_ignore_imports_alerting = none

[importlinter:contract:search-usage-subscribe-only]
name = search and usage call no other module
type = forbidden
source_modules =
    tumnis.modules.search
    tumnis.modules.usage
forbidden_modules =
    tumnis.modules.auth
    tumnis.modules.projects
    tumnis.modules.tasks
    tumnis.modules.planning
    tumnis.modules.agents
    tumnis.modules.focus
    tumnis.modules.decisions
    tumnis.modules.knowledge
    tumnis.modules.integrations
    tumnis.modules.calendar
    tumnis.modules.github
    tumnis.modules.coolify
    tumnis.modules.notifications
# usage's counter tests create real tasks through tasks' api (P0-21's seam, swapped by
# P0-18); usage code itself calls no module. search's index test trashes a task through
# tasks' api (P0-20's seam, swapped by P0-24).
ignore_imports =
    tumnis.modules.usage.tests.** -> tumnis.modules.tasks.api
    tumnis.modules.search.tests.** -> tumnis.modules.tasks.api
unmatched_ignore_imports_alerting = none

# contract.py imports pytest (P0-09). The sources are listed per level because a package
# never "imports" its own descendants: plain `tumnis` would miss tumnis.core.* importers.
[importlinter:contract:contract-base-test-only]
name = Only tests import the pytest-based adapter contract base
type = forbidden
source_modules =
    tumnis.*
    tumnis.core.*
    tumnis.core.adapters.*
forbidden_modules =
    tumnis.core.adapters.contract
    tumnis.modules.integrations.connector_contract
# The connector contract base (P0-12) builds on the adapter one and is test-only itself.
ignore_imports =
    tumnis.**.tests.** -> tumnis.core.adapters.contract
    tumnis.**.tests.** -> tumnis.modules.integrations.connector_contract
    tumnis.modules.integrations.connector_contract -> tumnis.core.adapters.contract
unmatched_ignore_imports_alerting = none

# P1-01: the Jev SDK is imported in one file, and the api process never reaches it (the
# adapter registry builds JevDecisions lazily, in the worker). Tests reach the adapter
# directly; ignoring the one sanctioned edge keeps them from counting as SDK importers.
[importlinter:contract:typesafe-sdk-in-jev-only]
name = Only the Jev adapter imports typesafe_sdk
type = forbidden
source_modules =
    tumnis.**
forbidden_modules =
    typesafe_sdk
ignore_imports =
    tumnis.modules.decisions.adapters.jev -> typesafe_sdk
unmatched_ignore_imports_alerting = none

[importlinter:contract:api-never-calls-out]
name = The api process never imports Jev, its SDK or VllmGeneration
type = forbidden
# The composition roots (tumnis.app, worker, cli, wiring) and every module's api, router
# and mcp, as single modules: none reaches an adapter through static imports. The worker
# builds JevDecisions, VllmDecisions (P1-02) and VllmGeneration (P1-03) lazily through the
# adapter registry. The name predates VllmDecisions (tests/meta/test_import_contracts.py
# matches it); the forbidden list below covers all three adapters. P2-13 adds the
# read-only GitHub client, built the same way.
as_packages = False
source_modules =
    tumnis.*
    tumnis.modules.*.api
    tumnis.modules.*.router
    tumnis.modules.*.mcp
forbidden_modules =
    tumnis.modules.decisions.adapters.jev
    tumnis.modules.decisions.adapters.vllm
    tumnis.modules.decisions.adapters.vllm_generation
    tumnis.modules.github.adapters.github_status
    typesafe_sdk

# P1-03 (FR-11.8): the Generation slot writes the placeholder first action and the spoken
# form of a focus message, never planning, triage or orchestration. Only the enrichment
# workflow (P1-08) and focus delivery (P2-16) may reach it; decisions reaches the adapter
# only through the registry, and decisions' own tests drive both files directly.
[importlinter:contract:generation-callers]
name = Only enrichment and focus delivery may use the Generation slot
type = protected
protected_modules =
    tumnis.modules.decisions.generation_api
    tumnis.modules.decisions.adapters.vllm_generation
allowed_importers =
    tumnis.modules.agents.workflows
    tumnis.modules.notifications
ignore_imports =
    tumnis.modules.decisions.tests.** -> tumnis.modules.decisions.generation_api
    tumnis.modules.decisions.tests.** -> tumnis.modules.decisions.adapters.vllm_generation
unmatched_ignore_imports_alerting = none
broken_contract_guidance =
    generation-callers: only tumnis.modules.agents.workflows (enrichment, P1-08) and
    tumnis.modules.notifications (spoken focus messages, P2-16) may import the Generation
    slot. Planning, triage and reasoning go through decisions.api or the project agent.
