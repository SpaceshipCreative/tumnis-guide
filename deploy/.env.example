# The server's .env for deploy/compose.yaml (Coolify, or the shell running `docker compose`).
# Copy it to .env beside compose.yaml and fill it in there; the repo never holds a real .env.
# Every value here is a placeholder: `changeme` must be replaced, blank means unset.
# File-based secrets (the master key, the pepper, the /metrics token) are not variables:
# they live in /etc/tumnis/secrets on the host (see deploy/README.md).

# Database role passwords (initdb sets them; they go into connection URLs, so use hex:
# `openssl rand -hex 32`).
APP_DB_PASSWORD=changeme
OWNER_DB_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# Image tag to run (deploy.yml sets sha-<commit>).
TUMNIS_VERSION=latest
DEPLOYMENT_MODE=self-hosted
DEPLOYMENT_ENV=prod
TUMNIS_ADAPTERS=real

# Observability (optional; blank keeps them off).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hosted speech provider (optional, P4-03; Scott decision 75). An OpenAI-compatible
# /v1/audio/speech API, used only for workspaces that allow hosted speech and never for a
# local-only project. On only when the URL, the model and the key are all set. Only the
# worker receives these. The key stays in this file: never in the database or the repo.
SPEECH__HOSTED_BASE_URL=
SPEECH__HOSTED_MODEL=
SPEECH__HOSTED_VOICE=
SPEECH__HOSTED_API_KEY=

# Hosted embedder (optional, P3-10; Scott decision 75). An OpenAI-compatible /v1/embeddings
# API; a local embedder, when configured, stays preferred, and a local-only project's text
# never goes here. On only when the URL, the model and the key are all set; DIMS is the
# model's vector size (blank: 1024). Only the worker receives these. The key stays in this
# file: never in the database or the repo.
EMBEDDINGS__HOSTED_BASE_URL=
EMBEDDINGS__HOSTED_MODEL=
EMBEDDINGS__HOSTED_DIMS=
EMBEDDINGS__HOSTED_API_KEY=
