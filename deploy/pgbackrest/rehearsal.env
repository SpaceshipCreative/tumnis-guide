# pgBackRest overrides for the compose.test stack and the rehearsal drill (P0-28): repo2
# goes to the stack's MinIO over TLS (self-signed, CA file from the minio-certs service)
# with path-style URLs. Environment variables override pgbackrest.conf, which an option
# repeated in conf.d cannot do. Not secrets; the throwaway keys are in test-conf.d.
PGBACKREST_REPO2_S3_ENDPOINT=minio
PGBACKREST_REPO2_STORAGE_PORT=9000
PGBACKREST_REPO2_S3_REGION=us-east-1
PGBACKREST_REPO2_S3_URI_STYLE=path
PGBACKREST_REPO2_STORAGE_CA_FILE=/etc/pgbackrest/minio/public.crt
